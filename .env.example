# Supabase — publishable values only (RLS is the real protection; never put a
# secret key sb_secret_… here or anywhere in the repo/bundle).
#
# Development: point at the local stack. Get the values with:
#   supabase start && supabase status -o env
#   (API_URL → VITE_SUPABASE_URL, PUBLISHABLE_KEY → VITE_SUPABASE_PUBLISHABLE_KEY)
#
# Production (hosting env vars):
#   VITE_SUPABASE_URL=https://hxkqgnyopnhxwwbbhpql.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
